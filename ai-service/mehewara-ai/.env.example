# ============================================================
# Mehewara AI Microservice — Environment Configuration
# ============================================================

# Google Gemini API Key (Required for Agent 1 and Agent 2)
# Obtain a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name (Gemini 3.5 Flash Lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# ASP.NET Core Backend Integration Base URL
DOTNET_API_BASE_URL=http://localhost:5153

# Microservice Runtime Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5153
