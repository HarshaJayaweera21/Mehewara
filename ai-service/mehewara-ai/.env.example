# ============================================================
# Mehewara AI Microservice — Environment Configuration
# ============================================================

# Shared Google Gemini API key for Agents 1–4 through the existing LLM factory.
# Obtain a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Project-configured model; preserve it or choose a model available to your account.
# Provider availability is not verified by this example.
GEMINI_MODEL=gemini-3.5-flash-lite

# ASP.NET Core Backend Integration Base URL
DOTNET_API_BASE_URL=http://localhost:5194

# Microservice Runtime Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5194

# Match ASP.NET AiService:InternalApiKey (fill locally, do not commit secrets).
INTERNAL_AI_API_KEY=
AGENT4_EVIDENCE_TIMEOUT_SECONDS=10
AGENT4_REVIEW_TIMEOUT_SECONDS=30
