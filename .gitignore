# ============================================================
# Mehewara - Root .gitignore
# Polyglot Monorepo
#
# Backend: ASP.NET Core 8 / .NET
# AI Service: FastAPI / Python / uv
# Web: React / Vite / TypeScript
# Mobile: Flutter / Dart
# Infrastructure: Docker / CI
# ============================================================


# ============================================================
# ENVIRONMENT / SECRETS / CREDENTIALS
# ============================================================

# Environment variable files
.env
.env.*
!.env.example
!.env.template
!.env.sample

*.env
*.env.local
*.env.development
*.env.production
*.env.test

# Docker environment overrides
docker/.env
docker/**/.env

# Certificates, private keys, credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der

secrets/
credentials/

# Service account credentials
service-account*.json

# ============================================================
# MOBILE SIGNING / KEYSTORE
# ============================================================

key.properties
**/key.properties

*.keystore
*.jks


# ============================================================
# OPERATING SYSTEM
# ============================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*


# ============================================================
# EDITORS / IDEs
# ============================================================

# Visual Studio Code
# Keep the repository free from machine-specific VS Code settings.
.vscode/

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates

# Native build architecture folders
x64/
x86/

# JetBrains / Android Studio / IntelliJ / PyCharm / Rider
.idea/
*.iml
*.ipr
*.iws


# ============================================================
# GENERAL LOGS / CACHE / TEMPORARY FILES
# ============================================================

*.log
logs/

*.tmp
*.temp
*.cache
*.bak
*.old
*.swp
*.swo
*.orig
*.rej

temp/
tmp/
scratch/


# ============================================================
# TEST / COVERAGE
# ============================================================

coverage/
**/coverage/

coverage.html
.nyc_output/

TestResults/
**/TestResults/

*.trx
*.coverage


# ============================================================
# ASP.NET CORE / .NET
# ============================================================

# Build outputs
**/bin/
**/obj/

# Generated assemblies and symbols
*.dll
*.exe
*.pdb
*.mdb

# User-specific project settings
*.rsuser

# NuGet packages
*.nupkg
*.snupkg
packages/

# Roslyn / MSBuild generated files
*.GeneratedMSBuildEditorConfig.editorconfig

# Local ASP.NET configuration overrides
appsettings*.local.json


# ============================================================
# IMPORTANT:
# .NET USER SECRETS
#
# User Secrets are stored outside the repository by .NET.
# Do NOT create a secrets.json file inside the project.
#
# The UserSecretsId in the .csproj is safe to commit.
# ============================================================


# ============================================================
# PYTHON / FASTAPI / UV
# ai-service/mehewara-ai
# ============================================================

# Python bytecode
__pycache__/
**/__pycache__/

*.py[cod]
*$py.class

# Python virtual environments
.venv/
**/.venv/

venv/
**/venv/

env/
ENV/

# Python packaging
*.egg-info/
.eggs/

# AI service build / distribution
**/ai-service/mehewara-ai/build/
**/ai-service/mehewara-ai/dist/

# Python caches
.pytest_cache/
**/.pytest_cache/

.mypy_cache/
**/.mypy_cache/

.ruff_cache/
**/.ruff_cache/

.hypothesis/
**/.hypothesis/

# Python coverage
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# IMPORTANT:
# uv.lock SHOULD be committed for reproducible builds.
# Do NOT ignore uv.lock.


# ============================================================
# AI SERVICE - MODELS / CHECKPOINTS / EXPERIMENTS
# ============================================================

# IMPORTANT:
# Scope these to the AI service.
# Do NOT use a generic "models/" rule because
# backend/Mehewara.API/Models/ contains C# source code.

**/ai-service/mehewara-ai/models/
**/ai-service/mehewara-ai/checkpoints/

# Large ML model files
*.safetensors
*.gguf
*.pt
*.pth
*.onnx

# Experiment tracking
experiments/
**/experiments/

runs/
**/runs/

wandb/
**/wandb/

mlruns/
**/mlruns/

# Vector stores / indexes
vector_store/
**/vector_store/

chroma/
**/chroma/

faiss_index/
**/faiss_index/


# ============================================================
# REACT / VITE / NODE / TYPESCRIPT
# web/mehewara-web
# ============================================================

# Dependencies
node_modules/
**/node_modules/

# Build outputs
**/dist/
**/dist-ssr/

# Vite cache
.vite/
**/.vite/

# Other bundler caches
.parcel-cache/
**/.parcel-cache/

.cache/
**/.cache/

# Package manager caches
.npm/
.pnpm-store/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Yarn Berry
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Keep .yarnrc.yml if it exists.
# It may contain project configuration.

# TypeScript build information
*.tsbuildinfo

# ESLint cache
.eslintcache


# ============================================================
# FLUTTER / DART
# mobile/mehewara_mobile
# ============================================================

# Dart / Flutter tooling
.dart_tool/
**/.dart_tool/

.pub/
**/.pub/

.pub-cache/
**/.pub-cache/

