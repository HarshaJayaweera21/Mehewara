# ============================================================
# UPLOADS & LOCAL USER MEDIA
# (Rule: Ignore uploaded runtime files without ignoring source assets)
# ============================================================

uploads/*
!uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

local-uploads/*
!local-uploads/.gitkeep
**/local-uploads/*
!**/local-uploads/.gitkeep

downloads/*
!downloads/.gitkeep
**/downloads/*
!**/downloads/.gitkeep

# Exclude generated / temporary AI media outputs while preserving source repository assets
**/ai-service/**/outputs/
**/ai-service/**/generated_images/