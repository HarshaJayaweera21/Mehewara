# ============================================================
# Mehewara - Root .gitignore
# Polyglot Monorepo:
# - Backend: ASP.NET Core 8 (.NET)
# - AI Service: FastAPI / Python 3.12 / uv
# - Web: React 19 / Vite / TypeScript
# - Mobile: Flutter / Dart (Android, iOS, Desktop, Web)
# - Infrastructure: Docker / CI Workflows
# ============================================================


# ============================================================
# ENVIRONMENT / SECRETS / CREDENTIALS
# ============================================================

# Environment variables
.env
.env.*
!.env.example
!.env.template
!.env.sample

*.env
*.env.local
*.env.development
*.env.production
*.env.test

# Docker environment overrides
docker/.env
docker/**/.env

# Certificates, keys, and credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
secrets/
credentials/
service-account*.json

# Mobile Keystore / Signing
key.properties
**/key.properties
*.keystore
*.jks


# ============================================================
# OPERATING SYSTEM SPECIFIC
# ============================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*


# ============================================================
# EDITORS AND IDES
# ============================================================

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# Visual Studio (C# / .NET / C++)
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
x64/
x86/

# JetBrains / Android Studio / IntelliJ / PyCharm / Rider
.idea/
*.iml
*.ipr
*.iws


