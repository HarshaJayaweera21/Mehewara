*.log
logs/
*.tmp
*.temp
*.cache
*.bak
*.old
*.swp
*.swo
*.orig
*.rej

temp/
tmp/
scratch/

# Coverage
coverage/
**/coverage/
coverage.html
.nyc_output/


# ============================================================
# ASP.NET CORE / .NET 8
# ============================================================

# Build outputs
**/bin/
**/obj/

# Generated assemblies and symbols
*.dll
*.exe
*.pdb
*.mdb

# User-specific project settings
*.rsuser

# Test outputs
TestResults/
*.trx
*.coverage

# NuGet packages & caches
*.nupkg
*.snupkg
packages/

# Roslyn / MSBuild
*.GeneratedMSBuildEditorConfig.editorconfig

# Local configuration overrides
appsettings*.local.json


# ============================================================
# PYTHON / FASTAPI / UV (AI SERVICE)
# ============================================================

# Python bytecode & cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
**/.venv/
venv/
**/venv/
env/
ENV/

# Python packaging and distributions
build/
dist/
wheels/
*.egg-info/
.eggs/

# Testing & Type checking / Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Coverage
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# IMPORTANT:
# Keep uv.lock committed for reproducible builds.
# Do NOT ignore uv.lock.


